# Variaveis de ambiente - NAO commite este arquivo!
# Copie para .env e preencha com seus valores reais.

# Chave da API do Groq (https://console.groq.com)
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXX

# Conexao com Supabase - use variaveis SEPARADAS para evitar
# problemas com caracteres especiais na senha (acentos, @, #, etc.)

# Usuario do banco (normalmente "postgres" no Supabase)
DB_USER=postgres

# Sua senha do Supabase (pode ter qualquer caractere, sem aspas)
DB_PASSWORD=suaSenhaAqui123

# Host do projeto Supabase: Settings > Database > Host
# Exemplo: db.abcdefghijklm.supabase.co
DB_HOST=db.XXXXXXXXXX.supabase.co

# Porta (5432 por padrao no Supabase)
DB_PORT=5432

# Nome do banco (normalmente "postgres")
DB_NAME=postgres

# ─── Login (Supabase Auth) ────────────────────────────────────────────────
# URL do projeto: Settings > API > Project URL
SUPABASE_URL=https://XXXXXXXXXX.supabase.co
# Chave pública (anon / publishable). Só é usada se o projeto ainda
# assina tokens com o segredo HS256 legado. NUNCA use a service_role aqui.
SUPABASE_ANON_KEY=eyJhbGciOi...

# (Opcional) Peso dado às notícias dos temas preferidos do usuário
PREFERENCE_BOOST=0.1
# (Opcional) Só ganha o bônus a notícia com score >= esta fração do melhor
# resultado (evita puxar notícia fora do assunto da pergunta)
PREFERENCE_MIN_RATIO=0.85

# (Opcional) Só vai para o contexto a notícia com score >= esta fração do
# melhor resultado (descarta as fracas em vez de sempre usar 5)
RELEVANCE_MIN_RATIO=0.75
# (Opcional) Em perguntas sobre "hoje", "últimas", "esta semana"..., a notícia
# ganha RECENCY_BOOST x 0.5^(idade em dias / RECENCY_HALF_LIFE_DAYS)
RECENCY_BOOST=0.1
RECENCY_HALF_LIFE_DAYS=1

# (Opcional) LLM da resposta e teto de tokens de saída. No plano gratuito do
# Groq o qwen aceita ~1000 tokens de saída por minuto; acima de ~900 aqui o
# Groq passa a recusar os pedidos (429).
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_TOKENS=600

# (Opcional) Modelo que traduz a pergunta para inglês antes da busca vetorial.
# Deixe vazio para desligar a tradução.
TRANSLATE_MODEL=openai/gpt-oss-20b
