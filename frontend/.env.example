# Copie para .env.local (dev) ou cadastre no Netlify (produção).

# URL do backend. Em dev pode ficar vazio (o Vite faz proxy para localhost:8000).
VITE_API_URL=

# Login (Supabase Auth): Settings > API no painel do Supabase.
# Sem estas duas variáveis o site funciona normalmente, só que sem login.
VITE_SUPABASE_URL=https://XXXXXXXXXX.supabase.co
# Chave PÚBLICA (anon / publishable). Nunca coloque a service_role no frontend.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Mostra o botão "Continuar com Google" (exige o provedor configurado no Supabase)
VITE_AUTH_GOOGLE=false
