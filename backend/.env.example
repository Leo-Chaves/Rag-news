# Variaveis de ambiente - NAO commite este arquivo!
# Copie para .env e preencha com seus valores reais.

# Chave da API do OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXX

# Modelos gratuitos da NVIDIA (Nemotron) no OpenRouter
# Opções de chat (gratuitos): nvidia/nemotron-3.5-super-vl:free, nvidia/nemotron-3-nano-30b-a3b:free, nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Opções de embedding (gratuitos): nvidia/nemotron-3.5-embed-1b:free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free

# Conexao com PostgreSQL + PGVector (Supabase ou Postgres local / Docker / Raspberry Pi)
# Use variaveis SEPARADAS para evitar problemas com caracteres especiais na senha (acentos, @, #, etc.)

# Usuario do banco ("postgres" no Supabase, ou ex.: "ragnews" local/Docker)
DB_USER=postgres

# Sua senha do banco (pode ter qualquer caractere, sem aspas)
DB_PASSWORD=suaSenhaAqui123

# Host do banco (Supabase: db.XXXXXXXXXX.supabase.co | Local: 127.0.0.1 | Docker: db)
DB_HOST=db.XXXXXXXXXX.supabase.co

# Porta (5432 por padrao)
DB_PORT=5432

# Nome do banco ("postgres" no Supabase, ou ex.: "ragnews" local/Docker)
DB_NAME=postgres

# Modo SSL ("disable" para Postgres local/Docker/Raspberry Pi; "require" para Supabase)
# Se vazio, o backend usa "disable" para 127.0.0.1/localhost/db/postgres e "require" para hosts remotos.
DB_SSLMODE=disable

# Autenticacao via e-mail/senha + JWT
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vazia, curta (< 32) ou igual a este exemplo: o backend usa uma chave aleatoria
# temporaria (ninguem forja tokens, mas os logins caem a cada reinicio).
JWT_SECRET_KEY=gere-uma-chave-secreta-forte-aqui
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Chave do POST /reset (apaga TODAS as noticias indexadas, inclusive as salvas
# pelos usuarios). Envie no cabecalho X-Admin-Key. Vazia = rota desligada.
ADMIN_API_KEY=

# (Opcional) Busca do chat
# So vai para o contexto a noticia com score >= esta fracao do melhor resultado
RELEVANCE_MIN_RATIO=0.75
# Em perguntas sobre "hoje", "ultimas", "esta semana"..., a noticia ganha
# RECENCY_BOOST x 0.5^(idade em dias / RECENCY_HALF_LIFE_DAYS)
RECENCY_BOOST=0.1
RECENCY_HALF_LIFE_DAYS=1
